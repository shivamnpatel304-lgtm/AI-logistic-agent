# Application Settings
APP_NAME=AI Logistics Agent
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
HOST=127.0.0.1
PORT=8000

# Database Configuration (Defaults to SQLite for instant local usage)
DATABASE_URL=sqlite:///./logistics.db

# Optional AI / LLM Configuration
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ENABLE_LLM_AGENT=False

# Logistics & Allocation Defaults
DEFAULT_MAX_DELIVERY_RADIUS_KM=500.0
HIGH_VALUE_ORDER_THRESHOLD=10000.0
SAFETY_STOCK_DEFAULT=20
